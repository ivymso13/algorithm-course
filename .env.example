# Teacher admin screen password (see /teacher). REQUIRED — there is no
# built-in default. If this is unset, every /api/teacher/* endpoint fails
# closed (503/401) instead of silently accepting a known password.
TEACHER_PASSWORD=

# Optional: seeds the first course's student-facing access code (students
# enter this + 학번 + 이름 to log in). If unset, a random 8-character code is
# generated on first use and shown on the teacher dashboard — set this only
# if you want a specific, memorable code instead.
# COURSE_CODE=

# Optional: how long a student session cookie stays valid, in seconds.
# Defaults to 28800 (8 hours — a class period plus slack).
# SESSION_TTL_SECONDS=28800

# Jev AI (TypeSafe AI) API Key for natural language algorithm execution (server-side only)
# Leave blank to use MOCK mode automatically for offline local testing
TYPESAFE_API_KEY=

# Set to true to force MOCK mode even if an API key is present
USE_JEV_MOCK=true

# Execution confidence threshold (default: 0.80)
JEV_EXECUTION_THRESHOLD=0.80
